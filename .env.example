# Auth0 Application Settings
# Replace with your tenant settings from Auth0 Dashboard > Applications > Your App
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# A secret string used for session signing and encryption (at least 32 characters long)
AUTH0_SECRET=your_32_character_session_secret_key_here

# The callback URL registered in your Auth0 Application settings
AUTH0_REDIRECT_URI=http://localhost:5000/callback

